  "description": "Universal MCP server untuk kontrol PC Windows — shell execution, file operations, screenshot, system info, process management, clipboard, dan lainnya.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pc-controller": "dist/index.js"
  },
  "scripts": {
